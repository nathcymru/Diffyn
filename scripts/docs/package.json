    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "12.2.0",
    "parse5": "8.0.1",
    "yaml": "2.9.1"
  }
