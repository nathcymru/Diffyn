{
  "name": "diffyn-documentation-checks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "cd ../.. && markdownlint-cli2",
    "check": "node check-docs.mjs",
    "style:check": "cd ../.. && prettier --check \"**/*.{js,cjs,mjs}\"",
    "style:fix": "cd ../.. && prettier --write \"**/*.{js,cjs,mjs}\""
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "devDependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "12.0.0",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.24.0",
    "mermaid": "12.2.0",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
